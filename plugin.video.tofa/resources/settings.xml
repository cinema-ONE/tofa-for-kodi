<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stored values only. Nothing here is a user-facing choice any more.

  Everything this file used to offer as a button or a picker now lives in the
  add-on's own Settings section (see resources/lib/settings_pages.py):

    sign_in / sign_out / switch_profile  ->  Settings > Account
    accent_color                         ->  Settings > Appearance (the fox
                                             picker; this copy is written
                                             alongside it as the offline
                                             fallback, never edited by hand)
    install_fonts                        ->  Settings > This Device
    device_id                            ->  Settings > This Device, read-only

  The three settings below still have to be DECLARED, because Kodi only
  persists a setting it knows about, but each is hidden, so opening the
  add-on's settings from Kodi's own add-on manager shows an empty dialog
  rather than a second, competing set of controls that could disagree with
  the section.
-->
<settings version="1">
    <section id="plugin.video.tofa">
        <category id="general" label="30000">
            <group id="1">
                <!-- The offline fallback accent. Kept in step with the
                     account's own `accent_color` preference by the fox
                     picker (windows/main.py:_settings_fox_clicked), so it is
                     always the right colour to fall back TO when the server
                     cannot be reached. See windows/theme.py. -->
                <setting id="accent_color" type="string" label="30031" help="30032">
                    <level>0</level>
                    <default>2DD4BF</default>
                    <visible>false</visible>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <control type="edit" format="string"/>
                </setting>
                <!-- Internal bookkeeping: the FONT_SET_VERSION the user last
                     declined. Settings > This Device asks again regardless. -->
                <setting id="fonts_declined_version" type="integer" label="30035">
                    <level>0</level>
                    <default>0</default>
                    <visible>false</visible>
                    <control type="edit" format="integer"/>
                </setting>
                <!-- The same decline, remembered per SKIN, as
                     `skin.estuary=25|skin.confluence=24`. The int above is
                     the pre-0.9.15 form and is migrated into this on first
                     read, then zeroed; it stays declared so an upgrade can
                     still read it. -->
                <setting id="fonts_declined_skins" type="string" label="30035">
                    <level>0</level>
                    <default></default>
                    <visible>false</visible>
                    <control type="edit" format="string"/>
                </setting>
                <!-- The same, for hostsetup.HOSTCONFIG_VERSION: the
                     advancedsettings.xml change the user last declined. Kept
                     separate from the font one so a new font set and a new
                     host-config expectation can each ask again on their own
                     terms, even though they share one dialog. -->
                <setting id="hostconfig_declined_version" type="integer" label="30035">
                    <level>0</level>
                    <default>0</default>
                    <visible>false</visible>
                    <control type="edit" format="integer"/>
                </setting>
                <!-- And again, for seekbarpatch.SEEKBAR_PATCH_VERSION: the
                     DialogSeekBar.xml edit the user last declined. Declining
                     this one is survivable; the player still works, the
                     skin's own seek bar just draws over it. -->
                <setting id="seekbar_declined_version" type="integer" label="30035">
                    <level>0</level>
                    <default>0</default>
                    <visible>false</visible>
                    <control type="edit" format="integer"/>
                </setting>
                <!-- And per skin, same format and same migration as
                     fonts_declined_skins above. -->
                <setting id="seekbar_declined_skins" type="string" label="30035">
                    <level>0</level>
                    <default></default>
                    <visible>false</visible>
                    <control type="edit" format="string"/>
                </setting>
                <!-- How much disk the artwork staging area may hold, in MB.
                     Picked on Settings > This Device; see
                     settings_options.ARTCACHE_BUDGETS. 0 means "unset", which
                     artcache.budget_bytes reads as its own default, so the
                     default lives in one place rather than two. -->
                <setting id="artcache_budget_mb" type="integer" label="30035">
                    <level>0</level>
                    <default>0</default>
                    <visible>false</visible>
                    <control type="edit" format="integer"/>
                </setting>
                <!-- Settings > Account > CONNECTION. DEVICE-local on
                     purpose, not a server preference: it describes how THIS
                     box reaches the server, and the same account on a phone
                     outside the house needs the relay this box may refuse.
                     api.MediaServerClient reads it (see _request's fallback).
                     -->
                <setting id="direct_only" type="boolean" label="30036">
                    <level>0</level>
                    <default>false</default>
                    <visible>false</visible>
                    <control type="toggle"/>
                </setting>
                <!-- Stable X-Tofa-Device-Id, minted once by auth.py and
                     shown read-only on Settings > This Device. Editing it by
                     hand would orphan the pairing. -->
                <setting id="device_id" type="string" label="30021" help="30022">
                    <level>0</level>
                    <default></default>
                    <visible>false</visible>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string"/>
                </setting>
            </group>
        </category>
    </section>
</settings>
