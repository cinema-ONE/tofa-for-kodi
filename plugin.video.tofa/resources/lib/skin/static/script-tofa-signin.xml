<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sign-in dialog skin XML, consumed by resources/lib/signin.py's
  SignInDialog (kodigui.BaseDialog).

  Fonts (tofa_font_caption/body/heading/link/code) are real Inter Tight /
  Roboto Mono, injected into the active skin's own Font.xml by
  fontinstall.ensure_tofa_fonts_installed() at runtime (Kodi's
  GUIFontManager never loads Font.xml from an add-on's own bundle
  directly). Until that has run and Kodi has restarted, these ids
  silently fall back to Kodi's own defaults; that's expected, not a bug.

  Positions use <coordinates><system>0</system></coordinates> resolution
  scaling, same as every other window in this add-on; a bare
  xbmcgui.WindowDialog would use raw screen pixels and break on anything
  other than 1920x1080.
-->
<window>
    <defaultcontrol always="true">666</defaultcontrol>
    <backgroundcolor>0x00000000</backgroundcolor>
    <coordinates>
        <system>0</system>
    </coordinates>
